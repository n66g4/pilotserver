#!/bin/sh
. "$(dirname "$0")/_common"

load_env() {
	if [ ! -f "${PILOTSERVER_ENV_FILE}" ]; then
		echo "missing ${PILOTSERVER_ENV_FILE}" >&2
		return 1
	fi
	# shellcheck disable=SC1090
	set -a
	. "${PILOTSERVER_ENV_FILE}"
	set +a
	# PUBLIC_BASE_URL may be empty; configure via /admin/ settings after start.
	return 0
}

report() {
	# Surface the reason in Package Center, not only in our log file.
	if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
		echo "$*" > "${SYNOPKG_TEMP_LOGFILE}"
	fi
	echo "$*" >&2
}

start_daemon() {
	load_env || { report "missing env file ${PILOTSERVER_ENV_FILE}"; return 1; }
	if [ ! -x "${PILOTSERVER_BIN}" ]; then
		report "missing binary ${PILOTSERVER_BIN}"
		return 1
	fi
	mkdir -p "${PILOTSERVER_VAR}" "${PILOTSERVER_DATA_DIR:-$PILOTSERVER_DATA_DEFAULT}"
	cd "${PILOTSERVER_DATA_DIR:-$PILOTSERVER_DATA_DEFAULT}" || return 1
	nohup "${PILOTSERVER_BIN}" >>"${PILOTSERVER_LOG}" 2>&1 &
	echo $! >"${PILOTSERVER_PID}"
	sleep 2
	if kill -0 "$(cat "${PILOTSERVER_PID}")" 2>/dev/null; then
		return 0
	fi
	report "pilotserver failed to start: $(tail -5 "${PILOTSERVER_LOG}" 2>/dev/null)"
	return 1
}

stop_daemon() {
	if [ -f "${PILOTSERVER_PID}" ]; then
		pid="$(cat "${PILOTSERVER_PID}")"
		kill "${pid}" 2>/dev/null || true
		i=0
		while [ "$i" -lt 20 ]; do
			kill -0 "${pid}" 2>/dev/null || break
			sleep 1
			i=$((i + 1))
		done
		kill -9 "${pid}" 2>/dev/null || true
		rm -f "${PILOTSERVER_PID}"
	fi
	return 0
}

daemon_status() {
	if [ -f "${PILOTSERVER_PID}" ] && kill -0 "$(cat "${PILOTSERVER_PID}")" 2>/dev/null; then
		return 0
	fi
	rm -f "${PILOTSERVER_PID}" 2>/dev/null || true
	return 1
}

case "$1" in
start)
	if daemon_status; then
		exit 0
	fi
	start_daemon
	exit $?
	;;
stop)
	stop_daemon
	exit $?
	;;
status)
	if daemon_status; then
		exit 0
	fi
	# 3 = package is not running (DSM convention); 1 means dead with pid file.
	exit 3
	;;
log)
	echo "${PILOTSERVER_LOG}"
	exit 0
	;;
prestart|prestop|preload)
	exit 0
	;;
*)
	exit 0
	;;
esac
