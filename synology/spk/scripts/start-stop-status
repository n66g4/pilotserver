#!/bin/sh
. "$(dirname "$0")/_common"

load_env() {
	if [ ! -f "${PILOTSERVER_ENV_FILE}" ]; then
		echo "missing ${PILOTSERVER_ENV_FILE}" >&2
		return 1
	fi
	# shellcheck disable=SC1090
	set -a
	. "${PILOTSERVER_ENV_FILE}"
	set +a

	if [ -z "${PILOTSERVER_PUBLIC_BASE_URL}" ]; then
		echo "Set PILOTSERVER_PUBLIC_BASE_URL in ${PILOTSERVER_ENV_FILE} to your HTTPS reverse-proxy URL (DSM DDNS hostname)." >&2
		return 1
	fi
	return 0
}

start_daemon() {
	load_env || return 1
	if [ ! -x "${PILOTSERVER_BIN}" ]; then
		echo "missing binary ${PILOTSERVER_BIN}" >&2
		return 1
	fi
	mkdir -p "${PILOTSERVER_VAR}" "${PILOTSERVER_DATA_DIR:-$PILOTSERVER_DATA_DEFAULT}"
	cd "${PILOTSERVER_DATA_DIR:-$PILOTSERVER_DATA_DEFAULT}" || return 1
	nohup "${PILOTSERVER_BIN}" >>"${PILOTSERVER_LOG}" 2>&1 &
	echo $! >"${PILOTSERVER_PID}"
	sleep 1
	if kill -0 "$(cat "${PILOTSERVER_PID}")" 2>/dev/null; then
		return 0
	fi
	echo "pilotserver failed to start; see ${PILOTSERVER_LOG}" >&2
	return 1
}

stop_daemon() {
	if [ -f "${PILOTSERVER_PID}" ]; then
		pid="$(cat "${PILOTSERVER_PID}")"
		kill "${pid}" 2>/dev/null || true
		i=0
		while [ "$i" -lt 20 ]; do
			kill -0 "${pid}" 2>/dev/null || break
			sleep 1
			i=$((i + 1))
		done
		kill -9 "${pid}" 2>/dev/null || true
		rm -f "${PILOTSERVER_PID}"
	fi
	return 0
}

daemon_status() {
	if [ -f "${PILOTSERVER_PID}" ] && kill -0 "$(cat "${PILOTSERVER_PID}")" 2>/dev/null; then
		return 0
	fi
	rm -f "${PILOTSERVER_PID}" 2>/dev/null || true
	return 1
}

case "$1" in
start)
	if daemon_status; then
		exit 0
	fi
	start_daemon
	exit $?
	;;
stop)
	stop_daemon
	exit $?
	;;
status)
	if daemon_status; then
		exit 0
	fi
	exit 1
	;;
log)
	exit 0
	;;
*)
	echo "Usage: $0 {start|stop|status|log}" >&2
	exit 1
	;;
esac
